# =====================================================================
# kb-rag 环境变量模板
# 使用方法：cp .env.example .env，按需修改后再启动 docker compose 或 kb-rag-server/parser。
# 安全默认值：任何真实密钥/密码不要提交进 git；.env 已在 .gitignore 中忽略。
# =====================================================================

# ---------------------------------------------------------------------
# 【第一部分】应用侧契约变量（docs/M1-CONTRACTS.md §1，kb-rag-server / kb-rag-parser 消费）
# ---------------------------------------------------------------------

# MySQL：kb-rag-server 通过 MYSQL_HOST/PORT 连接下方 docker-compose 拉起的 MySQL 容器
MYSQL_HOST=127.0.0.1
# 宿主机映射端口，避开本机默认 3306；容器内 MySQL 仍监听 3306
MYSQL_PORT=13306
MYSQL_DB=kb_rag
MYSQL_USER=kbrag
# 必填：应用账号密码，务必修改为强口令（compose 会用它初始化 kb_rag 库的账号）
MYSQL_PASSWORD=CHANGE_ME_mysql_password

# Elasticsearch：lite 模式下同时承担 BM25 全文检索与向量检索（D16），无需额外配置
ES_URI=http://127.0.0.1:9200

# Qdrant：仅 full 模式使用；lite 模式下留空即可（VECTOR_ENGINE=es 时不会读取此项）
QDRANT_URI=
# 必填（full 模式）：Qdrant 只要收到该变量就开启鉴权，留空等于"鉴权已开但密钥为空"，
# 应用侧每次读写向量都会 401；lite 模式不启动 Qdrant，此项不生效
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key

# MinIO：应用侧对象存储（文档原件 + 解析产物）；Qdrant 自带存储，不再需要专属 MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
# 必填：MinIO 要求 access key >= 3 字符、secret key >= 8 字符，否则容器启动失败
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=kb-files

# 向量引擎选型（D16）：es | qdrant；lite 默认 es，切到 qdrant 需先完成 full 模式部署与索引重建
VECTOR_ENGINE=es

# 模型 Key：留空 = 零 Key 模式（检索自动降级 BM25 单路、分片回退按长度切分，见需求文档 §5）
# 填写后即获得向量检索 + 语义能力全功能（云端路径：阿里云百炼 DashScope）
DASHSCOPE_API_KEY=

# 嵌入模型配置：EMBEDDING_DIM 必须与 EMBEDDING_MODEL 实际输出维度一致，M1 固定值无需改动
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# 一个文档嵌入时并发进行的嵌入请求数（一个批次 = 一次网络往返，批次之间无依赖）。500 个分片按批大小
# 10 算就是 50 次往返，串行跑是文档索引里最长的一段等待。这是**全局**上限（共享线程池），几个文档
# 同时索引也不会把嵌入服务的限流打穿；填 1 即恢复串行行为。
EMBEDDING_CONCURRENCY=4

# kb-rag-parser 服务地址，kb-rag-server 调用解析服务时使用
PARSER_BASE_URL=http://127.0.0.1:20001

# 视觉模型配置（M3，docs/M3-CONTRACTS.md §3.1）：图片/扫描页文本代理由 VisionProvider 调用生成，
# 走 DashScope 兼容 chat/completions 端点；VISION_TIMEOUT_MS 默认更长，因图片理解耗时高于纯文本
VISION_MODEL=qwen-vl-max
VISION_TIMEOUT_MS=20000

# 扫描页判定阈值（M3，docs/M3-CONTRACTS.md §2.1）：该页抽取文本去空白后长度小于此值即视为扫描页，
# 整页渲染成图片交给 VisionProvider 转录
SCANNED_PAGE_TEXT_THRESHOLD=20

# 乱码页判定阈值（M3 §2.1 补充，kb-rag-parser 消费）：pdf 页面文本层长度达标但可识别字符
# （ASCII/CJK/假名/中日标点等）占比低于此百分比，即判定为内嵌字体 ToUnicode CMap 损坏导致的乱码，
# 该页文本置空并按扫描页渲染成图片交 OCR/VLM 兜底。调高更激进（更多页走 OCR），调低更保守
GARBLED_PAGE_VALID_CHAR_RATIO_PCT=50

# 本地 OCR 兜底（M8/二期，docs/M8-CONTRACTS.md §0.4，kb-rag-parser 消费）：none=不启用（默认，
# 行为与 M3 一致）；paddle=扫描页由 parser 本地 PaddleOCR 出文本（零 Key/离线可用），需先在 parser
# 环境执行 pip install -r requirements-ocr.txt，未装依赖时 parser 启动即报错。带 OCR 文本的页
# kb-server 不再调 VLM。
OCR_ENGINE=none
# 单页 OCR 推理超时（秒），超时该页跳过并计数
OCR_TIMEOUT_S=30
# PaddleOCR 模型下载源（PaddleX 自带变量）：默认 HuggingFace 不可达时改用 ModelScope；
# 纯离线部署需预置模型缓存目录（首次运行会联网下载 PP-OCRv4 模型）
# PADDLE_PDX_MODEL_SOURCE=ModelScope

# --- 标注迁移与图片 query（M9/二期，docs/M9-CONTRACTS.md §0）---
# 标注相似度辅助迁移的候选最低 Dice 分（0..1）
ANNOTATION_MIGRATION_MIN_SCORE=0.35
# 图片 query 张数与大小上限（单张解码字节数 / 全部图片合计字节数）
IMAGE_QUERY_MAX_COUNT=3
IMAGE_QUERY_MAX_BYTES=5242880
IMAGE_QUERY_MAX_TOTAL_BYTES=10485760

# 单文档图片数量上限（M3，docs/M3-CONTRACTS.md §2.1）：超限的图片跳过并在解析响应 warnings[] 中
# 说明，不失败整篇文档。parser 与 server 共用该值：调大会同时放大解析响应体（每张图
# base64 内联），扫描件场景单张就有几百 KB
MAX_IMAGES_PER_DOC=100

# 单文档图片描述并发度（M3 后补，docs/M3-CONTRACTS.md §7.6）：一张图 = 一次 VLM 往返，
# 耗时是 VISION_TIMEOUT_MS 量级，串行时撑满上限的文档要占着索引槽位半小时。上界看模型服务
# 方的限流而不是本机 CPU（全程等待远端）；被限流的调用记为 FAILED 且不重试，开过头
# 是拿图片文本丢失换延迟。≤ 1 则退回串行
IMAGE_DESCRIBE_CONCURRENCY=8

# Demo 数据集目录（M3，docs/M3-CONTRACTS.md §3.7）：POST /api/v1/system/demo/import 读取该目录下
# manifest.json 与文档文件一键建库导入。本地开发默认指向本仓库 demo/ 目录的绝对路径；
# 镜像内路径固定为 /opt/kb-rag/demo（Dockerfile 打包 demo/ 到该路径），生产部署按容器内路径设置
DEMO_DATA_DIR=/Users/zhangfuqiang/AI/kb-rag/kb-rag-deploy/demo


# ---------------------------------------------------------------------
# 【第二部分】docker-compose 专用变量（仅供中间件容器初始化使用，非契约变量）
# ---------------------------------------------------------------------

# --- MySQL 容器 ---
# root 口令仅用于容器初始化与 scripts/backup.sh 做 mysqldump，应用侧不使用该账号
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root

# --- Elasticsearch 容器 ---
ES_PORT=9200

# --- MinIO 容器 ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Qdrant（full 模式）容器 ---
# REST 端口，应用侧通过它读写向量；gRPC 端口暂未使用，保留以便将来切换传输层
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Redis（full 模式，可选，需 --profile redis 显式启用）---
# 留空 = 不设密码（仅建议本地开发使用）；单实例部署可完全不启用 Redis（cache.provider=local）
REDIS_PORT=6379
REDIS_PASSWORD=

# --- scripts/backup.sh 备份配置 ---
# 备份产物落地目录（宿主机路径），建议指向独立磁盘/外部挂载点
BACKUP_DIR=./backups
# 保留份数（轮转策略：mysqldump 与 minio 快照各自按此份数滚动清理旧备份）
BACKUP_KEEP_COUNT=7

# --- scripts/preflight.sh 校验开关 ---
# 期望的最小可用内存档位：lite | full（分别对应 8GB / 24GB 门槛，见需求文档 §5 资源要求矩阵）
DEPLOY_PROFILE=lite

# 管理台 CORS 白名单（可选，默认放行 localhost/127.0.0.1:20002；生产改为真实域名）
CORS_ALLOWED_ORIGINS=

# 重排模型（默认 gte-rerank-v2；旧版 gte-rerank 部分账号无权访问会返回 403）
RERANK_MODEL=gte-rerank-v2

# 文档非激活版本保留份数（M4a；超出的版本归档并清理分片，仅保留原件与解析产物用于重建；取值 1-20）
DOC_VERSION_RETAIN_COUNT=3

# --- 评测体系（M4b，docs/M4b-CONTRACTS.md §3）---
# LLM-as-judge 独立模型配置：留空则沿用 CHAT_MODEL（即 ChatProvider 当前配置的模型），仅当需要
# 用不同模型评分时才显式覆盖
EVAL_JUDGE_MODEL=

# 评测运行离线执行档超时（毫秒）：评测运行时改写与重排超时统一放宽为此值，线上 P95 承诺不适用
EVAL_OFFLINE_TIMEOUT_MS=10000

# 评测运行并发度：逐 case 并发执行的数量，复用既有检索链路
EVAL_CONCURRENCY=4

# 命中判定聚合覆盖阈值：Top-K 内全部召回 chunk 对同一 span 的覆盖并集比例达到此阈值即判定命中
EVAL_OVERLAP_THRESHOLD=0.5

# 降级 case 自动重试次数：评测运行中出现降级标记的 case 会按此次数自动重试，重试后仍降级不拦截
# （拦截属 M4c 门禁范畴），仅在报告中显著提示 case_degraded 数
EVAL_DEGRADED_RETRY=2

# M4c 应用发布与对外 API
API_RATE_LIMIT_DEFAULT=10
AUDIT_RETENTION_DAYS=180
GATE_MIN_CASES=50
GATE_EPSILON_PP=2
GATE_STALE_RATIO=0.15
CHAT_ANSWER_MAX_TOKENS=1024
# 答案生成的 HTTP 读超时（毫秒）；路由/改写仍走 CHAT_TIMEOUT_MS 的短预算
CHAT_GENERATE_TIMEOUT_MS=60000

# --- 多知识库路由（M5，docs/M5-CONTRACTS.md §1/§2.1/§6）---
# 应用版本最多可关联的知识库数量上限（1..15）
RETRIEVAL_MAX_LINKED_KB=15
# 路由决策缓存（query+候选库集合+生效 prompt 哈希）存活时间，分钟
RETRIEVAL_ROUTING_CACHE_TTL_MINUTES=10
# 路由决策缓存最大条目数（超出按 LRU 淘汰）
RETRIEVAL_ROUTING_CACHE_MAX_SIZE=10000

# --- 索引快照发布（M6，docs/M6-CONTRACTS.md §0/§5）---
# 每应用保留的 SUPERSEDED 版本快照数量（RELEASED 快照永不清理）
APP_SNAPSHOT_RETAIN_COUNT=3
# 单库快照创建整体超时，毫秒（ES _clone 毫秒级；Qdrant 批量拷贝场景才可能逼近）
APP_SNAPSHOT_TIMEOUT_MS=300000
# 快照保留清理任务调度（Spring cron）与开关
# 值含空格，必须加引号：.env 会被 shell source（preflight.sh 与自测流程都如此），
# 不加引号会被解析成 "临时变量+命令"，改动静默失效
APP_SNAPSHOT_CLEANUP_CRON="0 15 4 * * *"
APP_SNAPSHOT_CLEANUP_ENABLED=true
# 检索版本可见集缓存（管理台/测试版路径；快照路径不走缓存）
RETRIEVAL_VISIBLE_VERSION_CACHE_TTL_MINUTES=5
RETRIEVAL_VISIBLE_VERSION_CACHE_MAX_SIZE=1000

# --- GraphRAG（M7，docs/M7-CONTRACTS.md §0/§5）---
# Neo4j Bolt 地址：留空 = 图能力整体禁用（不影响其余功能）；compose 用 profile=graph 启用容器：
#   docker compose -f docker-compose.lite.yml --profile graph up -d
NEO4J_URI=
NEO4J_USER=neo4j
# Neo4j 密码（compose 首次初始化与应用侧连接共用）
NEO4J_PASSWORD=
# 图路扩展最大跳数（实现侧 clamp 0..5）
GRAPH_MAX_HOPS=2
# query 实体 fulltext 匹配取前 M 个实体
GRAPH_ENTITY_MATCH_LIMIT=10
# 一次抽取任务内并发进行的 LLM 调用数（每次调用固定 1 分片）。抽取耗时几乎全在模型调用上，这个值
# 直接决定一次全量抽取要跑多久：一万个分片按每次 3 秒算，并发 2 是四个多小时，并发 8 是一小时出头。
# 图写入由单写入者线程串行执行，调高并发不影响 Neo4j MERGE 的正确性，只需看模型侧限流是否吃得住；
# 同时进行的抽取任务数受索引池上限（4）约束，所以模型侧峰值并发是两者之积。
GRAPH_EXTRACT_CONCURRENCY=8
# 单次抽取的生成上限。不能复用 CHAT_MAX_TOKENS（那是给一行 query 改写用的 128）：
# 抽取要输出整段的实体关系 JSON，预算耗尽会把 JSON 截断，解析器只能拒绝，分片被计入"跳过"
GRAPH_EXTRACT_MAX_TOKENS=2048

# --- 检索质量闭环（M10，docs/M10-CONTRACTS.md §2.2）---
# 检索洞察记录开关：关闭后仅停止新增记录，报表端点与清理仍对存量行生效
INSIGHT_ENABLED=true
# 洞察行保留天数：洞察是统计不是取证，到期直接删除，不像审计那样先归档到对象存储
INSIGHT_RETENTION_DAYS=90
# 到期清理每批删除行数与调度（cron 含空格必须加引号，理由同 APP_SNAPSHOT_CLEANUP_CRON）
INSIGHT_CLEANUP_BATCH_SIZE=5000
INSIGHT_CLEANUP_CRON="0 45 3 * * *"
# --- 内容治理（M11，docs/M11-CONTRACTS.md §2.2）---
# 回收站保留天数：超期后定时任务自动彻底删除（等同 purge，含两个检索引擎副本）
TRASH_RETENTION_DAYS=30
# 自动清除每批处理的文档数与调度（cron 含空格必须加引号，理由同 INSIGHT_CLEANUP_CRON）
TRASH_PURGE_BATCH_SIZE=100
TRASH_PURGE_CRON="0 10 4 * * *"
# 定时清除总开关：关闭后回收站文档永久保留，仅能手动 purge
TRASH_PURGE_ENABLED=true

# --- 数据接入：URL 导入与增量同步（M12，docs/M12-CONTRACTS.md §3）---
# 单页抓取超时（毫秒）与页面体积上限（MB，流式计数，超限即断）
WEB_IMPORT_FETCH_TIMEOUT_MS=10000
WEB_IMPORT_MAX_PAGE_SIZE_MB=10
# 手动跟随重定向的最大跳数（每一跳都重过 SSRF 防线）
WEB_IMPORT_MAX_REDIRECTS=3
# 定时同步调度与开关（cron 含空格必须加引号，理由同 APP_SNAPSHOT_CLEANUP_CRON）
WEB_IMPORT_SYNC_CRON="0 30 2 * * *"
WEB_IMPORT_SYNC_ENABLED=true
# 单轮定时同步处理的登记数上限（按 id 升序取一批，单条失败不中断本轮）
WEB_IMPORT_SYNC_BATCH_SIZE=50

# --- 外部数据源连接器（M14，docs/M14-CONTRACTS.md §2.4）---
# S3/OSS 兼容对象存储连接器：登记 bucket/prefix 后按前缀扫描对象走上传链路入库，ETag 增量同步。
# 定时扫描调度与开关（cron 含空格必须加引号，理由同 WEB_IMPORT_SYNC_CRON）
EXT_SOURCE_SYNC_CRON="0 0 3 * * *"
EXT_SOURCE_SYNC_ENABLED=true
# 单轮定时扫描处理的数据源数上限；每个源扫描整桶，故批量小于 URL 导入
EXT_SOURCE_SYNC_BATCH_SIZE=10
# 单次扫描入库的对象数上限；列举超出即将本次同步标记为 PARTIAL 而非无界拉取
EXT_SOURCE_MAX_OBJECTS_PER_SOURCE=500
# 单次对象存储调用超时（毫秒），连接与读取同预算
EXT_SOURCE_FETCH_TIMEOUT_MS=30000

# --- 视觉理解整页索引：多模态向量（M14，docs/M14-CONTRACTS.md §6.1）---
# 多模态嵌入模型（DashScope multimodal-embedding-v1，1024 维，与全家桶同 Key）；
# MULTIMODAL_EMBEDDING_API_KEY 留空则继承 DASHSCOPE_API_KEY，两者皆空 = 多模态能力整体关闭
# （知识库多模态开关可存但索引/检索跳过，行为同零 Key 降级）
MULTIMODAL_EMBEDDING_MODEL=multimodal-embedding-v1
MULTIMODAL_EMBEDDING_API_KEY=
MULTIMODAL_EMBEDDING_DIM=1024
# DashScope 多模态嵌入走原生端点（非 OpenAI 兼容面），故为完整 URL
MULTIMODAL_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
MULTIMODAL_EMBEDDING_TIMEOUT_MS=30000

# --- Rerank 混合模式（M14，docs/M14-CONTRACTS.md §5）---
# 部署级重排模式默认：semantic=纯语义重排分排序（现状）；hybrid=语义重排分与归一化 BM25 分线性加权，
# 仅影响排序、不改变 score_threshold 的绝对阈值语义。请求 > 知识库 > 此部署默认（五层优先级照旧）
RETRIEVAL_RERANK_MODE=semantic
# hybrid 模式下语义分权重（0-1），BM25 权重 = 1 - 此值
RETRIEVAL_RERANK_W_SEMANTIC=0.7

# --- 权限体系与单点登录（M15，docs/M15-CONTRACTS.md §2/§6）---
# 会话与本地口令策略（与 RBAC 无关，历来即有，此处集中列出便于查阅）
AUTH_TOKEN_TTL_HOURS=24
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# 空库首启自动创建的引导管理员用户名（口令随机生成并打印在启动日志，首登强制修改）
AUTH_BOOTSTRAP_USERNAME=admin
# 域账号单点登录总开关。关闭时登录页不呈现「单点登录」页签——没有域控的部署必须仍能用平台账号进来，
# 摆一个只会超时的入口比不摆更糟
AUTH_LDAP_ENABLED=false
# 域控地址，ldap://host:389 或 ldaps://host:636（生产建议 ldaps，simple bind 的口令是明文过线的）
AUTH_LDAP_URL=
# 登录名后缀，拼成 bind 主体，如 @corp.example.com。这是部署侧知识，不该让每个人每次登录重打一遍
AUTH_LDAP_DOMAIN_SUFFIX=
# 单次 bind 的连接与读取预算（毫秒）：域控不可达时登录请求要有界失败，而不是挂到网关超时
AUTH_LDAP_CONNECT_TIMEOUT_MS=3000
AUTH_LDAP_READ_TIMEOUT_MS=5000
# 域账号首次登录自动建号时授予的角色编码。刻意只给只读：不授角色则认证成功的人落到空控制台再来提单，
# 而放宽一档就等于给每个持域账号的人开了写权限。需要更高权限由管理员在用户管理页显式授予
AUTH_LDAP_DEFAULT_ROLE_CODE=VIEWER

# --- 企业化：多租户 / 组同步 / SSO 三协议 / 操作审计（M16，docs/M16-CONTRACTS.md §2）---
# LDAP 组同步：开启后每次单点登录读取 memberOf，按映射反授角色。同步授的角色每次登录全量替换，
# 手工授的角色永不触碰；开启期间 AUTH_LDAP_DEFAULT_ROLE_CODE 失效——组即角色的事实源
AUTH_LDAP_GROUP_SYNC_ENABLED=false
# 组到角色映射，groupDn=ROLE_CODE 分号分隔，DN 比较忽略大小写与空白，
# 如 cn=kb-admins,ou=groups,dc=corp,dc=example,dc=com=KB_ADMIN;cn=kb-users,ou=groups,dc=corp,dc=example,dc=com=VIEWER
AUTH_LDAP_GROUP_ROLE_MAPPINGS=
# OIDC（授权码模式）。仅需 issuer——全部端点取自 {issuer}/.well-known/openid-configuration 发现文档，
# 手工配的端点会和 IdP 实际提供的漂移
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid profile email
# SAML 2.0（仅 SP-initiated POST）。IdP 签名证书直接贴 PEM 进环境变量——证书是断言验签的唯一信任锚，
# 引一个 metadata 拉取器就要处理它的可用性与真实性
AUTH_SAML_ENABLED=false
AUTH_SAML_IDP_ENTITY_ID=
AUTH_SAML_IDP_SSO_URL=
AUTH_SAML_IDP_CERTIFICATE=
AUTH_SAML_SP_ENTITY_ID=kb-rag
# CAS 3.0。server-url 如 https://cas.corp.example.com/cas，票据校验走 /p3/serviceValidate
AUTH_CAS_ENABLED=false
AUTH_CAS_SERVER_URL=
# 回调成功后浏览器重定向的前端地址，如 https://kb.corp.example.com。留空则三协议即使开启也判未配置——
# 一个不知道把令牌送去哪里的回调没有安全的去处
AUTH_SSO_WEB_BASE_URL=
# 操作审计保留期（天），对齐 M6 API 审计的 180 天；到期由每日清理任务分批删除
AUDIT_OPERATION_RETENTION_DAYS=180
